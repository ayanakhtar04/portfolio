# Development Dockerfile with hot reload support

FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite port
EXPOSE 5173

# Start dev server with HMR enabled
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
